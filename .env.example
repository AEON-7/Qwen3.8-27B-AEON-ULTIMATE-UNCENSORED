# Qwen3.8-27B-AEON-ULTIMATE-UNCENSORED-NVFP4-MIXED - compose env example
# Copy to .env and edit paths / network for your box.
# Prefer HF cache root + serve by repo-id when possible (avoids snapshot symlink dangling links).

# ─── Image pins ───
# Spark / GB10 (sm_121a): pin dated until :latest digest matches sha256:2421bb...
SPARK_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:2026-09-11-v0.29.0-omni
# Rollback: ghcr.io/aeon-7/aeon-vllm-ultimate:2026-09-07-reasoning-eos
# RTX 5090 / PRO 6000 (sm_120):
RTX_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate-rtx:latest
# Dated known-good: ghcr.io/aeon-7/aeon-vllm-ultimate-rtx:2026-09-07-omni-mm

# ─── Weights (pick ONE style) ───
# Style A - local materialized trees under ./models/ (compose default):
MODEL_HOST_PATH=./models/aeon-mixed
DRAFT_HOST_PATH=./models/dflash2
# Style B - HF cache root + revision (document in compose overrides):
# HF_CACHE=$HOME/.cache/huggingface
# MODEL_REPO=AEON-7/Qwen3.8-27B-AEON-ULTIMATE-UNCENSORED-NVFP4-MIXED
# MODEL_REVISION=<rev>

# ─── ModelOpt #54367 bind (REQUIRED on Spark 0.29 for MIXED) ───
PATCH_HOST_PATH=./patches/modelopt-54367.py

# ─── API ───
HOST_PORT=8000
SERVED_MODEL_NAME=aeon

# ─── TP=2 dual Spark (edit per pair) ───
MASTER_IP=10.10.10.1
NODE0_IP=10.10.10.1
NODE1_IP=10.10.10.2
IFACE=enp1s0f0np0
# NCCL exact-match: keep the leading '=' so the value is "=rocep1s0f0:1"
IB_HCA==rocep1s0f0:1
MASTER_PORT=29501
